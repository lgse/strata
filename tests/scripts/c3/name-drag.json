{
  "bullets": [
    "browser/selection/pointer-intent: On an unselected entry, a drag from the icon or rendered filename starts a file drag."
  ],
  "scene": "c3-default-light",
  "events": [
    {
      "t": 0.2,
      "type": "tap",
      "key": "row-1/icon"
