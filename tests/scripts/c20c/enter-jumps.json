  ],
  "scene": "c20c-settings-light",
  "events": [
    {
      "t": 0.2,
      "type": "tap",
      "key": "c20c-nav-about"
    },
    {
      "t": 0.4,
      "type": "tap",
      "key": "c20c-search-field"
    },
    {
