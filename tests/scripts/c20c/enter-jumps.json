    {
      "t": 1.3,
      "type": "key",
      "name": "Enter"
    },
    {
      "t": 1.8,
      "type": "mark",
      "name": "end"
    }
  ],
  "expect": [
    {
      "key": "c20c-title",
      "name": "General"
    },
    {
      "key": "c20c-search-row-thumbnail-workers"
    },
    {
      "key": "c20c-workers-input",
      "focused": true
