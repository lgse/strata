{
  "bullets": [
    "browser/navigation/location-bar/completion: While editing, a popover under the entry, matching its width, lists child folders"
  ],
  "scene": "c6-short-light",
  "events": [
    {
      "t": 0.2,
      "type": "key",
      "name": "l",
      "cmd": true
    },
    {
      "t": 0.3,
      "type": "type",
