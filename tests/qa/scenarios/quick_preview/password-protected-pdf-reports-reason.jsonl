{"scenario":"password-protected-pdf-reports-reason","modes":["columns"],"prefs":{"single_click_previews":false},"tree":{"damaged.pdf":"%PDF-1.7\nThis PDF is password protected.\n"},"setup":[{"fs":{"path":"$data/applications","mkdir":true}},{"fs":{"path":"$environment/record-files","write":"#!/bin/sh\nprintf \"%s\\n\" \"$$@\" > \"$environment/opened-files\"\n"}},{"fs":{"path":"$environment/record-files","chmod":"755"}},{"fs":{"path":"$data/applications/strata-pdf-viewer.desktop","write":"[Desktop Entry]\nType=Application\nName=Review PDF Viewer\nExec=$environment/record-files %U\nMimeType=application/pdf;\n"}},{"fs":{"path":"$config/mimeapps.list","write":"[Default Applications]\napplication/pdf=strata-pdf-viewer.desktop;\n[Added Associations]\napplication/pdf=strata-pdf-viewer.desktop;\n"}},{"fs":{"path":"protected.pdf","from_repository":"tests/fixtures/documents/password-protected.pdf"}},{"fs":{"path":"ordinary.pdf","from_repository":"tests/fixtures/documents/text.pdf"}},{"fs":{"path":"owner.pdf","from_repository":"tests/fixtures/documents/owner-restricted.pdf"}}]}
{"select_with_keyboard":"protected.pdf"}
{"wait":{"focused":"protected.pdf"},"message":"the protected PDF to have focus"}
