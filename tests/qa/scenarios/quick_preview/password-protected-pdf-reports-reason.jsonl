{"expect":[{"present":{"role":"button","name":"Open","within":{"preview":true}}},{"absent":{"role":"password text","within":{"preview":true}}},{"absent":{"role":"image","name":"PDF page text","within":{"preview":true}}}],"message":"the protected PDF offers an Open button without a password prompt or rendered page"}
{"key":"Right"}
{"wait":{"focused_widget":"Open"},"message":"Right to hand the keys to the Open button"}
{"key":"Down"}
{"expect":{"focused_widget":"Open"},"message":"Down keeps the keys on the Open button instead of walking focus to the footer"}
{"key":"Return"}
{"fs":{"path":"$environment/opened-files","opened":["$fixture/protected.pdf"]},"message":"Return on the Open button to hand the protected PDF to the default PDF viewer"}
{"key":"Left"}
{"wait":{"focused":"protected.pdf"},"message":"Left to return the keys to the listing"}
{"select_with_keyboard":"ordinary.pdf"}
{"wait":{"all":[{"preview":"ordinary.pdf"},{"present":{"role":"image","name":"PDF page text","within":{"preview":true}}}]},"message":"an ordinary PDF still renders after the protected PDF"}
{"expect":[{"not":{"preview":"This PDF is password protected."}},{"not":{"preview":"Preview unavailable"}}],"message":"the password-protected message clears when another PDF renders"}
{"select_with_keyboard":"owner.pdf"}
{"wait":{"all":[{"preview":"owner.pdf"},{"present":{"role":"image","name":"PDF page text","within":{"preview":true}}}]},"message":"an owner-restricted PDF with an empty user password still previews"}
{"expect":[{"not":{"preview":"This PDF is password protected."}},{"not":{"preview":"Preview unavailable"}}],"message":"encryption alone does not imply that a password is required"}
