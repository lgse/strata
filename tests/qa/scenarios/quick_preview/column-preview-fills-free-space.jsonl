{"expect":{"compare":{"left":"$nested","op":"<","right":"$initial"}}}
{"remember":{"preview":true},"as":"bounds"}
{"note":"number","expr":{"floor_divide":[{"of":{"kept":"bounds"},"get":"width"},5]},"as":"distance"}
