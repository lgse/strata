{"scenario":"column-preview-fills-free-space","modes":["columns"],"prefs":{"single_click_previews":false},"layout":"us","mutation":null,"known_bug":null,"tree":{"notes.txt":"the quick brown fox\n","page.md":"# Heading\n\nBody text.\n","third.txt":"third preview fixture\n","data.csv":"name,value\nalpha,1\n","folder":{"inner.txt":"inner\n","nested-notes.txt":"nested preview fixture\n"}},"cost":{"columns":1.4},"quality":{"impact":2,"coverage":3,"criticality":4,"diagnostic":3,"score":25,"note":"Column preview fill and drag-set session minimum across reopen/parent; fill+narrow drag shared with filled-preview-outlines-minimum; minimum unit-tested only for keyboard"}}
{"select_with_keyboard":"notes.txt"}
