                          "key": "input",
                          "name": "Script",
                          "role": "multiline-text-input",
                          "value": "#!/usr/bin/env bash\n# Rename every photo by the day it was taken.\nset -euo pipefail\n\ndir=\"${1:-$HOME/Pictures}\"\ncount=0\nfor f in \"$dir\"/*.jpg; do\n  stamp=$(date -r \"$f\" +%Y-%m-%d)\n  mv -n \"$f\" \"$dir/$stamp-$((count++)).jpg\"\ndone\n\ncat <<EOF\nRenamed $count photos in $dir\nEOF\n"
                        }
                      ],
