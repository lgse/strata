# Generated by scripts/update_aur.py from packaging/aur/PKGBUILD.in.
# Edit the template and re-render; do not edit this file directly.

pkgname=strata-preview-bin
pkgver=0.7.1rc2
pkgrel=1
# The upstream release version, which for a prerelease differs from pkgver:
# pkgver must not contain a hyphen, so v0.8.0-rc.1 is packaged as 0.8.0rc1.
_releasever=0.7.1-rc.2
pkgdesc="A fast, keyboard-first file manager for Linux (preview releases)"
arch=('x86_64' 'aarch64')
url="https://github.com/lgse/strata"
license=('GPL-3.0-or-later')
depends=(
  'bubblewrap'
  'fontconfig'
  'glibc>=2.39'
  'gtk4>=4.12'
  'gtksourceview5'
  'poppler-glib'
)
optdepends=(
  'ffmpeg: video previews'
  'ffmpegthumbnailer: video thumbnails'
  'gst-libav: additional media format playback'
  'gst-plugins-good: media playback in previews'
  'gvfs-smb: SMB network locations'
  'imagemagick: RAW image previews'
  'libraw: RAW image previews when ImageMagick is unavailable'
)
provides=('strata')
conflicts=('strata' 'strata-bin')
# The published binary is covered by a GitHub build-provenance attestation.
# Stripping rewrites it, so `gh attestation verify` would no longer match the
# file this package installs. There are no sources to build, so a debug package
# would hold nothing but an empty /usr/src/debug directory.
options=('!strip' '!debug')
source_x86_64=("${url}/releases/download/v${_releasever}/strata-${_releasever}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${url}/releases/download/v${_releasever}/strata-${_releasever}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('99422640f13c71f966ae367cd11231921f071e7146307c98256873d83aa425bf')
sha256sums_aarch64=('55b16993a43722c4f13b6afda943c97ad83294911f1b7793e83548a48a06ddd7')

package() {
  local dist="${srcdir}/strata-${_releasever}-${CARCH}-unknown-linux-gnu"

  install -Dm755 "${dist}/strata" "${pkgdir}/usr/bin/strata"
  install -Dm644 "${dist}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${dist}/THIRD_PARTY_LICENSES.md" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_LICENSES.md"

  # Desktop metadata ships inside the release archive. Releases published before
  # it was added carry none, and produce a package with a working `strata`
  # command but no launcher.
  if [[ -f "${dist}/io.github.lgse.Strata.desktop" ]]; then
    install -Dm644 "${dist}/io.github.lgse.Strata.desktop" \
      "${pkgdir}/usr/share/applications/io.github.lgse.Strata.desktop"
    install -Dm644 "${dist}/io.github.lgse.Strata.svg" \
      "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.github.lgse.Strata.svg"
  else
    warning "Strata ${_releasever} ships no desktop entry or application icon; installing without a launcher."
  fi

  # Tells Strata that pacman owns /usr/bin/strata, so the in-app updater reports
  # new releases but never installs over package-owned files.
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/strata/install-source.toml" <<'MARKER'
manager = "pacman"
package = "strata-preview-bin"
channel = "preview"
update_command = "sudo pacman -Syu strata-preview-bin"
alternate_package = "strata-bin"
MARKER
}
